{
  "name": "chapter-trail",
  "version": "1.0.0",
  "description": "Folder-level ordering, auto-maintained index pages and statically publishable series navigation for Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "node scripts/gate.mjs",
    "check:core-purity": "node scripts/check-core-purity.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "sorting",
    "index",
    "navigation"
  ],
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@tanstack/react-virtual": "^3.14.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "obsidian": "^1.14.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
